+      provenance = ProvenanceStatus.LOCAL_DEVICE,
+      rightsConfirmed = true,
+    )
+
+  @Test
+  fun build_emptyLibrary_yieldsEmptyShelves() {
+    val feed = HomeFeedModel.build(emptyList(), favorites = emptySet(), recommender = OnDeviceRecommender())
