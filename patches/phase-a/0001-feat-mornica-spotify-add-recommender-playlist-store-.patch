+
+    val feed = HomeFeedModel.build(tracks, favorites = emptySet(), recommender = reco)
+    val recent = feed.shelves.firstOrNull { it.key == "recent" }
+    assertTrue(recent != null)
+    assertEquals("1", recent!!.tracks.first().id)
+  }
+}
