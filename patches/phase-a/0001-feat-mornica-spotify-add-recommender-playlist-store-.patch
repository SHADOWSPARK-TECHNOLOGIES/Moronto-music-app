+
+  private fun track(id: String, artist: String = "Artist") =
+    LocalMediaTrack(
+      id = id,
+      title = "Title $id",
+      artist = artist,
+      album = "Album",
+      folderName = "Folder",
+      durationMs = 200_000L,
