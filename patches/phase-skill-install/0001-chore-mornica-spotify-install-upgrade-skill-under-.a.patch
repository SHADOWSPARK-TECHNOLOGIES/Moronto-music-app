+#!/usr/bin/env bash
+# Mornica Spotify-grade gates. Run from anywhere; locates the repo root by walking
+# up to settings.gradle.kts. Mirrors the mandatory gates in repo AGENTS.md.
+set -euo pipefail
+
+SCRIPT_DIR="$(cd "$(dirname "${BASH_SOURCE[0]}")" && pwd)"
+ROOT="$SCRIPT_DIR"
+while [ ! -f "$ROOT/settings.gradle.kts" ] && [ "$ROOT" != "/" ]; do
+  ROOT="$(dirname "$ROOT")"
+done
+if [ ! -f "$ROOT/settings.gradle.kts" ]; then
+  echo "ERROR: settings.gradle.kts not found above $SCRIPT_DIR" >&2
+  echo "Copy this skill into the repo (.agents/skills/mornica-spotify-grade-upgrade/) before running." >&2
+  exit 1
+fi
+cd "$ROOT"
+
+echo "== [1/3] unit tests: :app:testDebugUnitTest =="
+./gradlew :app:testDebugUnitTest
+
+echo "== [2/3] lint: :app:lintDebug (expect 0 errors) =="
+./gradlew :app:lintDebug
+
+echo "== [3/3] debug APK: :app:assembleDebug =="
+./gradlew :app:assembleDebug
+
+echo "OK: local gates green. Instrumented playback test (when touching playback):"
+echo "./gradlew :app:connectedDebugAndroidTest -Pandroid.testInstrumentationRunnerArguments.class=com.shadowspark.morontomornica.LicensedCatalogPlaybackInstrumentedTest"
