+#!/usr/bin/env bash
+# Static consistency check over bundled templates (no Android SDK required):
+# 1. Every non-test Kotlin template: package suffix matches its folder under templates/.
+# 2. Test templates: package matches the expected source package from a small map.
+# 3. Guardrail tokens absent: no yt-dlp / googlevideo extraction language in code files.
+set -uo pipefail
+
+SKILL_DIR="$(cd "$(dirname "${BASH_SOURCE[0]}")/.." && pwd)"
+TPL_DIR="$SKILL_DIR/assets/templates"
+fail=0
+
+check_package_path() {
+  local file="$1"
+  local rel="${file#$TPL_DIR/}"
+  local dir="$(dirname "$rel")"
+  local expected_suffix="${dir//\//.}"
+  local actual_package
+  actual_package="$(grep -E '^package ' "$file" | head -1 | sed 's/^package //; s/[[:space:]]*$//')"
+  local expected="com.shadowspark.morontomornica.$expected_suffix"
+  if [ "$actual_package" != "$expected" ]; then
+    echo "FAIL package: $rel"
+    echo "  expected: $expected"
+    echo "  actual:   $actual_package"
+    fail=1
+  fi
+}
+
+declare -A TEST_PKG=(
+  ["OnDeviceRecommenderTest.kt"]="com.shadowspark.morontomornica.core.reco"
+  ["PlaylistRepositoryTest.kt"]="com.shadowspark.morontomornica.data.local"
+  ["HomeFeedModelTest.kt"]="com.shadowspark.morontomornica.ui.home"
+)
+
+while IFS= read -r file; do
+  base="$(basename "$file")"
+  if [[ "$base" == *Test.kt ]]; then
+    expected="${TEST_PKG[$base]:-}"
+    if [ -z "$expected" ]; then
+      echo "FAIL unmapped test: $base (add TEST_PKG entry)"
+      fail=1
+      continue
+    fi
+    actual="$(grep -E '^package ' "$file" | head -1 | sed 's/^package //; s/[[:space:]]*$//')"
+    if [ "$actual" != "$expected" ]; then
+      echo "FAIL test package $base: expected $expected, got $actual"
+      fail=1
+    fi
+    if ! grep -q "@Test" "$file"; then
+      echo "FAIL test file has no @Test: $base"
+      fail=1
+    fi
+  else
+    check_package_path "$file"
+  fi
+done < <(find "$TPL_DIR" -name '*.kt' -type f | sort)
+
+# Guardrail tokens: these must never appear in template code.
+while IFS= read -r file; do
+  if grep -nE 'yt-dlp|googlevideo\.com|extractAudio|youtube\.com/watch\?v=.*(setData|setUrl|play)' "$file" >/dev/null; then
+    echo "FAIL guardrail token in: ${file#$TPL_DIR/}"
+    grep -nE 'yt-dlp|googlevideo\.com|extractAudio' "$file"
+    fail=1
+  fi
+done < <(find "$TPL_DIR" -name '*.kt' -type f)
+
+if [ "$fail" -eq 0 ]; then
+  echo "OK: template package/path and guardrail-token checks passed."
+else
+  echo "FAILED: fix the entries above before handing templates to the build agent." >&2
+  exit 1
+fi
