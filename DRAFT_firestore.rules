rules_version = '2';
service cloud.firestore {
  match /databases/{database}/documents {
    // Global Safety Net (Default Deny)
    match /{document=**} {
      allow read, write: if false;
    }

    function isValidId(id) {
      return id is string && id.size() >= 1 && id.size() <= 128 && id.matches('^[a-zA-Z0-9_\\-]+$');
    }

    function incoming() {
      return request.resource.data;
    }

    function existing() {
      return resource.data;
    }

    function isSignedIn() {
      return request.auth != null;
    }

    function isVerifiedUser() {
      return isSignedIn() && request.auth.token.email_verified == true;
    }

    function isOwner(userId) {
      return isVerifiedUser() && request.auth.uid == userId;
    }

    function isValidUserProfile(data, userId) {
      return data.keys().hasAll([
        'uid',
        'displayName',
        'email',
        'providerId',
        'language',
        'themeId',
        'createdAt',
        'updatedAt'
      ])
      && data.keys().hasOnly([
        'uid',
        'displayName',
        'email',
        'providerId',
        'language',
        'themeId',
        'createdAt',
        'updatedAt'
      ])
      && isValidId(data.uid)
      && data.uid == userId
      && data.uid == request.auth.uid
      && data.displayName is string
      && data.displayName.size() >= 1
      && data.displayName.size() <= 80
      && data.email is string
      && data.email.size() >= 3
      && data.email.size() <= 160
      && data.providerId in ['google.com', 'password', 'other']
      && data.language in ['en', 'pcm', 'yo', 'ig', 'ha']
      && data.themeId in ['emerald-console', 'sunset-brass', 'lagos-indigo', 'obsidian-rose']
      && data.createdAt is timestamp
      && data.updatedAt is timestamp;
    }

    function isValidSupportRequest(data) {
      return data.keys().hasAll([
        'userId',
        'userEmail',
        'displayName',
        'deviceType',
        'topic',
        'message',
        'status',
        'createdAt',
        'updatedAt'
      ])
      && data.keys().hasOnly([
        'userId',
        'userEmail',
        'displayName',
        'deviceType',
        'topic',
        'message',
        'status',
        'createdAt',
        'updatedAt'
      ])
      && isValidId(data.userId)
      && data.userId == request.auth.uid
      && data.userEmail is string
      && data.userEmail.size() >= 3
      && data.userEmail.size() <= 160
      && data.displayName is string
      && data.displayName.size() >= 1
      && data.displayName.size() <= 80
      && data.deviceType in ['android', 'iphone', 'windows-mac', 'other']
      && data.topic is string
      && data.topic.size() >= 3
      && data.topic.size() <= 120
      && data.message is string
      && data.message.size() >= 10
      && data.message.size() <= 1000
      && data.status in ['open', 'resolved']
      && data.createdAt is timestamp
      && data.updatedAt is timestamp;
    }

    match /users/{userId}/private/profile {
      allow get: if isValidId(userId) && isOwner(userId);
      allow list: if false;
      allow create: if isValidId(userId)
        && isOwner(userId)
        && isValidUserProfile(incoming(), userId)
        && incoming().createdAt == request.time
        && incoming().updatedAt == request.time;
      allow update: if isValidId(userId)
        && isOwner(userId)
        && isValidUserProfile(incoming(), userId)
        && incoming().uid == existing().uid
        && incoming().email == existing().email
        && incoming().createdAt == existing().createdAt
        && incoming().updatedAt == request.time
        && incoming().diff(existing()).affectedKeys().hasOnly([
          'displayName',
          'language',
          'themeId',
          'updatedAt'
        ]);
      allow delete: if false;
    }

    match /support_requests/{requestId} {
      allow get: if isValidId(requestId)
        && isVerifiedUser()
        && existing().userId == request.auth.uid;
      allow list: if isVerifiedUser()
        && resource.data.userId == request.auth.uid;
      allow create: if isValidId(requestId)
        && isVerifiedUser()
        && isValidSupportRequest(incoming())
        && incoming().status == 'open'
        && incoming().createdAt == request.time
        && incoming().updatedAt == request.time;
      allow update: if isValidId(requestId)
        && isVerifiedUser()
        && existing().userId == request.auth.uid
        && existing().status != 'resolved'
        && isValidSupportRequest(incoming())
        && incoming().userId == existing().userId
        && incoming().userEmail == existing().userEmail
        && incoming().createdAt == existing().createdAt
        && incoming().updatedAt == request.time
        && incoming().diff(existing()).affectedKeys().hasOnly([
          'message',
          'updatedAt'
        ]);
      allow delete: if false;
    }
  }
}
